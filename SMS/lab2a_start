#!/bin/bash
#
# Script Name: lab2a_start
# Description: Run command - labstart lab2a
# Version: 2.2.0 (Camino fixes - see CHANGES.md)

LAUNCH_MODE=background
#VERBOSE=false

PROC_NAME="CPM"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lab_script_functions"

kill_proc() {
    {
    CPM_PID=$(cpwd_admin getpid -name $PROC_NAME)
    if [ $CPM_PID -gt 0 ] ; then
        kill -9 $CPM_PID 
    fi
    } 2>/dev/null
}
verbose_echo "Killing $PROC_NAME every 15 seconds"
echo -e "\nSetup completed\n"
while true; do
    kill_proc
    sleep 15
done
