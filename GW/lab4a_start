#!/bin/bash
#
# Script Name: lab4a_start
# Description: Run command - labstart lab4a
# Version: 2.2.0 (see CHANGES.md)

LAUNCH_MODE=background
#VERBOSE=false

PROC_NAME="cpd"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lab_script_functions"

kill_proc() {
    if pgrep -x "$PROC_NAME" >/dev/null 2>&1; then
        pkill -9 -x $PROC_NAME 2>/dev/null
    fi
}

verbose_echo "Killing $PROC_NAME every 15 seconds"
echo -e "\nSetup completed\n"
while true; do
    kill_proc
    sleep 15
done
