#!/bin/bash
#
# Script Name: lab4a_stop
# Description: Run command - labstop lab4a
# Version: 2.2.4 (see CHANGES.md)

LAUNCH_MODE=background
#VERBOSE=false

if [[ -z "$1" ]]; then
    echo "Usage: $0 <PID>"
    exit 1
fi

PROCESS_ID=$1
shift

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lab_script_functions"

verbose_echo "Killing process id $PROCESS_ID"

kill -9 "$PROCESS_ID" 2>/dev/null

echo -e "\nSetup completed"
echo "Next (lab guide step 4A-4.2): start CPD again on this gateway with:"
echo '    cpwd_admin start -name CPD -path "$CPDIR/bin/cpd" -command "cpd"'
echo "then check it with: cpwd_admin list"
 exit 0
