#!/bin/bash
#
# Script Name: lab8a_start
# Description: Run command - labstart lab8a
# Version: 2.2.0 (Camino fixes - see CHANGES.md)

#VERBOSE=false

source /etc/profile.d/CP.sh

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lab_script_functions"

# Variables
LAYER_NAME="Web Content layer"  
RULE_NAME="Media Access rule"
MARKETING_RULE="Marketing Access rule"
ACCESS_ROLE="Media Team"
POLICIES=("Alpha-Standard" "Bravo-Standard")
TARGETS=("A-GW-CLUSTER" "B-GW")

TMP_OTPT="/tmp/lab8a.json"
TMP_ERR="/tmp/lab8a.err"
SID="" 


discard_close_session() {
    verbose_echo "Discarding all changes"
    mgmt_cli discard --session-id "$SID" -f json >> $TMP_OTPT 2>> $TMP_ERR
    mgmt_cli logout --session-id "$SID" -f json >> $TMP_OTPT 2>> $TMP_ERR   
    echo -e "\nSetup ended"
    exit $1
}

# Creating session
verbose_echo "Creating login session"
mgmt_cli login -r true -f json > $TMP_OTPT 2> $TMP_ERR
if [ $? -ne 0 ]; then
    echo -e "\nERROR: Failed to login"
    cat $TMP_OTPT
    cat $TMP_ERR
    exit 1
fi
 
SID=$(jq -r '.sid' $TMP_OTPT)
require_sid
trap lab_interrupted INT TERM HUP

#check if access role already exists
mgmt_cli show-access-role name "$ACCESS_ROLE" -f json --session-id "$SID" > $TMP_OTPT 2> $TMP_ERR
if [ $? -eq 0 ]; then
    verbose_echo "Access role $ACCESS_ROLE already exists, Skipping .."
else
#create access role
    verbose_echo "Creating role - $ACCESS_ROLE"
    mgmt_cli add-access-role name "$ACCESS_ROLE" color firebrick comments "Access role for the Corporate Media Team" users.source "Alpha_LDAP" users.selection "Even" -f json --session-id "$SID" > $TMP_OTPT 2> $TMP_ERR
    if [ $? -ne 0 ]; then 
        echo -e "\nERROR: Could not create access role $ACCESS_ROLE. Aborting"
        show_api_error
        discard_close_session 1
    fi
    verbose_echo "Access role $ACCESS_ROLE created"
fi
 

# Add rule 

mgmt_cli show-access-rule name "$RULE_NAME" layer "$LAYER_NAME" --session-id "$SID" -f json > $TMP_OTPT  2> $TMP_ERR
# Check if the rule already exists
if [ $? -eq 0 ]; then
    verbose_echo "Required rule already exists..Skipping"
    lab_already_set_up lab8a "'$RULE_NAME' already exists in '$LAYER_NAME'"
    discard_close_session 0
else
    verbose_echo "Adding rule $RULE_NAME to $LAYER_NAME..."
    mgmt_cli show-access-rule name "$MARKETING_RULE" layer "$LAYER_NAME" --session-id "$SID" -f json > $TMP_OTPT  2> $TMP_ERR
    if [ $? -eq 0 ]; then
        mgmt_cli add-access-rule layer "$LAYER_NAME" position.below "$MARKETING_RULE" name "$RULE_NAME" source "$ACCESS_ROLE"  destination "Internet" application.1 "YouTube" application.2 "Instagram" application.3 "TikTok" application.4 "Facebook" application.5 "FC2" action "Reject" track.type "None" --session-id "$SID" -f json > $TMP_OTPT  2> $TMP_ERR
    else
        mgmt_cli add-access-rule layer "$LAYER_NAME" position top name "$RULE_NAME" source "$ACCESS_ROLE"  destination "Internet" application.1 "YouTube" application.2 "Instagram" application.3 "TikTok" application.4 "Facebook" application.5 "FC2" action "Reject" track.type "None" --session-id "$SID" -f json > $TMP_OTPT  2> $TMP_ERR
    fi
    if [ $? -ne 0 ]; then
        echo -e "\nERROR: Failed to add rule #1"
        show_api_error
        discard_close_session 1
    fi
fi

# Publish changes
verbose_echo "Publishing changes"
mgmt_cli publish --session-id "$SID" -f json > $TMP_OTPT  2> $TMP_ERR
if [ $? -ne 0 ]; then
    echo -e "\nERROR: Could not publish changes"
    cat $TMP_ERR
    discard_close_session 1
fi

# Install policies
for i in "${!POLICIES[@]}"; do
    POLICY="${POLICIES[$i]}"
    TARGET="${TARGETS[$i]}"
    
    verbose_echo "Installing policy: $POLICY on target: $TARGET"
    mgmt_cli install-policy policy-package "$POLICY" targets $TARGET --sync false  --session-id "$SID" -f json > $TMP_OTPT 2> $TMP_ERR
    if [ $? -ne 0 ]; then
        echo -e "\nERROR: Failed to install policy."
        cat $TMP_ERR
        discard_close_session 1
    fi
done

mgmt_cli logout --session-id "$SID" -f json >> $TMP_OTPT 2>> $TMP_ERR

echo -e "\nSetup completed. Kindly check policy installation status in SmartConsole"
exit 0
