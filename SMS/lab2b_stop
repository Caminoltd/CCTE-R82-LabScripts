#!/bin/bash
#
# Script Name: lab2b_stop
# Description: Run command - labstop lab2b
# Version: 2.2.0 (see CHANGES.md)

#VERBOSE=false

source /etc/profile.d/CP.sh

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lab_script_functions"

# Variables
HOSTNAME=$(hostname)
A_SMS_STATE=""
A_SMS_02_STATE=""

TMP_OTPT="/tmp/lab2b.json"
TMP_ERR="/tmp/lab2b.err"

get_ha_states() {
    # Get the HA state 
    verbose_echo "Getting state of Management HA"
    mgmt_cli -f json -r true show ha-state > $TMP_OTPT 2> $TMP_ERR
    if [[ $? -ne 0 ]]; then
        echo -e "\nUnable to get state of Management HA"
        exit 1
    fi
    A_SMS_STATE=$(jq -r ' .domains[].servers[] | select(.name=="A-SMS") | ."ha-state"'  $TMP_OTPT)
    A_SMS_02_STATE=$(jq -r ' .domains[].servers[] | select(.name=="A-SMS-02") | ."ha-state"'  $TMP_OTPT) 
    verbose_echo "States - A-SMS is $A_SMS_STATE and A-SMS-02 is $A_SMS_02_STATE"
}

check_reject_route_exists() {
    verbose_echo "Checking if route to A-SMS-02 is rejected"
    clish -c "show route static" | grep -q '10.1.1.111/32.*is a reject route'
}

restore_connectivity() {
    clish -c "lock database override" > /dev/null 2>&1
    clish -c "set static-route 10.1.1.111/32 off"  > $TMP_OTPT 2> $TMP_ERR
    if ! check_reject_route_exists; then
        verbose_echo "Connectivity to A-SMS-02 restored"
    else
        echo -e "\nError restoring connectivity to A-SMS-02, please check with administrator"
        exit 1
    fi
}

get_ha_states

if [[ "$HOSTNAME" == "A-SMS" ]]; then
    if check_reject_route_exists; then
        verbose_echo 'Restoring connectivity'
        restore_connectivity
        sleep 2
        get_ha_states
    fi

    if [[ "$A_SMS_STATE" != "active" ]]; then
        verbose_echo "Changing state of A-SMS to active"
        mgmt_cli -f json -r true set ha-state new-state active > "$TMP_OTPT" 2> "$TMP_ERR"
         if [ $? -eq 0 ]; then
            verbose_echo "A-SMS state changed to active"
        else
            echo -e "\nUnable to change state of A-SMS to active"
            jq  -r '.message' $TMP_OTPT 2> /dev/null
            cat $TMP_ERR
            exit 1
        fi
        get_ha_states
    
        if [[ "$A_SMS_STATE" != "active" ]]; then
            echo -e "\nError - Unable to change A-SMS state to active"
            exit 1
        fi
    fi

    if [[ "$A_SMS_02_STATE" == "active" ]]; then
        echo -e "\nKindly run the stop script on A-SMS-02 first"
        exit 1
    elif [[ "$A_SMS_02_STATE" != "standby" ]]; then
        echo -e "\nA-SMS-02 state is $A_SMS_02_STATE. Please try later."
        exit 1
    fi
    
    if [[ $(mgmt_cli -f json -r true show ha-status | jq -r '."successfully-synced"') != true ]]; then
        verbose_echo "Synchronizing A-SMS-02. Please wait, this can take a while..."
        mgmt_cli -f json -r true ha-full-sync name "A-SMS-02"  > $TMP_OTPT 2> $TMP_ERR
        if [ $? -eq 0 ]; then
            verbose_echo "Synched successfully!"
        else
            echo -e "\nSynchronization failed"
            jq  -r '.message' $TMP_OTPT 2> /dev/null
            cat $TMP_ERR
            exit 1
        fi
    fi
    echo -e "\nSetup completed. Relaunch SmartConsole if required."
elif [[ "$HOSTNAME" == "A-SMS-02" ]]; then
    if [[ "$A_SMS_02_STATE" != "standby" ]]; then
        verbose_echo "Setting A-SMS-02 to standby"
        mgmt_cli -f json -r true set ha-state new-state standby > "$TMP_OTPT" 2> "$TMP_ERR"
         if [ $? -eq 0 ]; then
            verbose_echo "A-SMS-02 state changed to standby"
        else
            echo -e "\nUnable to change state of A-SMS-02 to standby"
            jq  -r '.message' $TMP_OTPT 2> /dev/null
            cat $TMP_ERR
            exit 1
        fi
        get_ha_states

        if [[ "$A_SMS_02_STATE" != "standby" ]]; then
            echo -e "\nError - Unable to change state to Standby"
            exit 1
        fi
    fi
    echo -e "\nSetup completed. Relaunch SmartConsole if required."
else
    echo -e "\nThis script only runs on A-SMS and A-SMS-02"
    exit 1
fi
