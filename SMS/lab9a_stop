#!/bin/bash
#
# Script Name: lab9a_stop
# Description: Run command - labstop lab9a
# Version: 2.2.0 (Camino fixes - see CHANGES.md)

#VERBOSE=false

source /etc/profile.d/CP.sh

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/lab_script_functions"

# Variables
POLICIES=("Alpha-Standard" "Bravo-Standard")
TARGETS=("A-GW-CLUSTER" "B-GW")

TMP_OTPT="/tmp/lab9a.json"
TMP_ERR="/tmp/lab9a.err"
SID="" 


discard_close_session() {
    verbose_echo "Discarding all changes"
    mgmt_cli discard --session-id "$SID" -f json >> $TMP_OTPT 2>> $TMP_ERR
    mgmt_cli logout --session-id "$SID" -f json >> $TMP_OTPT 2>> $TMP_ERR   
    echo -e "\nSetup ended"
    exit $1
}

# Creating session
verbose_echo "Creating login session"
mgmt_cli login -r true -f json > $TMP_OTPT 2> $TMP_ERR
if [ $? -ne 0 ]; then
    echo -e "\nERROR: Failed to login"
    cat $TMP_OTPT
    cat $TMP_ERR
    exit 1
fi
 
SID=$(jq -r '.sid' $TMP_OTPT)
require_sid
trap lab_interrupted INT TERM HUP

if mgmt_cli show vpn-community-star name Bravo2AlphaVPN --session-id "$SID" -f json > /dev/null 2>&1; then
    verbose_echo "Removing Bravo2AlphaVPN community"
    mgmt_cli delete vpn-community-star name Bravo2AlphaVPN  --session-id "$SID" -f json > $TMP_OTPT  2> $TMP_ERR
    if [ $? -ne 0 ]; then
          echo -e "\nERROR: Failed to remove vpn community"
          show_api_error
          discard_close_session 1
    fi
else
    verbose_echo "Bravo2AlphaVPN community not found..Skipping"
fi

verbose_echo "Adding A-GW-Cluster to Alpha2BravoVPN community"
mgmt_cli set vpn-community-meshed name "Alpha2BravoVPN" gateways.add "A-GW-Cluster" --session-id "$SID" -f json > $TMP_OTPT  2> $TMP_ERR
if [ $? -ne 0 ]; then
      # Already a member is fine (second run)
      if ! grep -qi "already" $TMP_OTPT; then
          echo -e "\nCould not add A-GW-Cluster to Alpha2BravoVPN"
          show_api_error
      fi
fi

# Publish changes
verbose_echo "Publishing changes"
mgmt_cli publish --session-id "$SID" -f json > $TMP_OTPT  2> $TMP_ERR
if [ $? -ne 0 ]; then
    echo -e "\nERROR: Could not publish changes"
    cat $TMP_ERR
    discard_close_session 1
fi

# Install policies
for i in "${!POLICIES[@]}"; do
    POLICY="${POLICIES[$i]}"
    TARGET="${TARGETS[$i]}"
    
    verbose_echo "Installing policy: $POLICY on target: $TARGET"
    mgmt_cli install-policy policy-package "$POLICY" targets $TARGET --sync false  --session-id "$SID" -f json > $TMP_OTPT 2> $TMP_ERR
    if [ $? -ne 0 ]; then
        echo -e "\nERROR: Failed to install policy."
        cat $TMP_ERR
        discard_close_session 1
    fi
done

mgmt_cli logout --session-id "$SID" -f json >> $TMP_OTPT 2>> $TMP_ERR

echo -e "\nSetup completed. Kindly check policy installation status in SmartConsole"
exit 0
